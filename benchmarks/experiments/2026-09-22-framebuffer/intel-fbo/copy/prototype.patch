@@ -257,6 +374,7 @@ R_Bloom(void)
 
 	/* 2. downsample: render the captured view into the BLOOM_SIZE corner,
 	 *    then copy that into the effect texture. */
+	offscreen = R_Bloom_BeginWorkspace();
 	qglViewport(0, 0, BLOOM_SIZE, BLOOM_SIZE);
 	qglMatrixMode(GL_PROJECTION);
 	qglLoadIdentity();
@@ -353,6 +471,8 @@ R_Bloom(void)
 		blur_y_error = qglGetError();
 	}
 
+	if (offscreen) R_Bloom_EndWorkspace();
+
 	/* 5. composite over the full view rectangle.
 	 *
 	 * The downsample/darken/blur passes above rendered into the bottom-left
@@ -372,7 +492,7 @@ R_Bloom(void)
 	R_TexEnv(GL_REPLACE);
 	qglColor4f(1, 1, 1, 1);
 	R_Bind(TEXNUM_BLOOMSCREEN);
-	R_Bloom_RestoreScene();
+	if (!offscreen) R_Bloom_RestoreScene();
 
 	/* 5b. add the bloom */
 	qglEnable(GL_BLEND);
