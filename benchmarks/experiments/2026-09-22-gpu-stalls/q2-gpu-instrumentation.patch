 #include "header/local.h"
+#include <mach/mach_time.h>
+
+/* DIAGNOSTIC ONLY. Mode1 serializes boundaries with Finish; mode2 records
+ * asynchronous CPU submission. Neither is a pure GPU timer. */
+static cvar_t *gl_gpu_profile;
+static qboolean gpu_profile_active;
+static int gpu_profile_mode, gpu_profile_frames, gpu_profile_warmup;
+static double gpu_profile_last, gpu_profile_total[15];
+static const char *gpu_profile_names[15] = {
+	"prior", "setup", "world", "entities_shadows", "effects",
+	"capture", "downsample", "darken", "blur_x", "blur_y",
+	"restore", "composite", "bloom_tail", "hud", "swap"
+};
+
+static double
+R_GPUProfileClock(void)
+{
+	static mach_timebase_info_data_t timebase;
+	if (!timebase.denom) mach_timebase_info(&timebase);
+	return (double)mach_absolute_time() * timebase.numer / timebase.denom / 1000000.0;
+}
+
+void
+R_GPUProfileMark(int stage)
+{
+	double now;
+	if (!gpu_profile_active) return;
+	R_ApplyGLBuffer();
+	if (gpu_profile_mode == 1) qglFinish();
+	now = R_GPUProfileClock();
+	if (gpu_profile_warmup >= 20) gpu_profile_total[stage] += now - gpu_profile_last;
+	gpu_profile_last = now;
+}
+
+static void
+R_GPUProfileBegin(void)
+{
+	int mode = (int)gl_gpu_profile->value;
+	gpu_profile_active = mode > 0 && !(r_newrefdef.rdflags & RDF_NOWORLDMODEL);
+	if (!gpu_profile_active) return;
+	if (gpu_profile_mode != mode)
+	{
+		GLint samples = 0, buffers = 0;
+		gpu_profile_mode = mode;
+		gpu_profile_frames = gpu_profile_warmup = 0;
+		memset(gpu_profile_total, 0, sizeof(gpu_profile_total));
+		qglGetIntegerv(0x80A8, &buffers);
+		qglGetIntegerv(0x80A9, &samples);
+		ri.Con_Printf(PRINT_ALL, "GPU_PROFILE mode=%d sample_buffers=%d samples=%d\n", mode, buffers, samples);
+	}
+	gpu_profile_last = R_GPUProfileClock();
+	R_GPUProfileMark(0);
+}
+
+void
+R_GPUProfileEnd(void)
+{
+	int stage;
+	if (!gpu_profile_active) return;
+	R_GPUProfileMark(14);
+	gpu_profile_active = false;
+	if (gpu_profile_warmup++ < 20) return;
+	if (++gpu_profile_frames < 120) return;
+	for (stage = 0; stage < 15; stage++)
+		ri.Con_Printf(PRINT_ALL, "GPU_PROFILE mode=%d frames=%d stage=%s ms=%.4f\n",
+			gpu_profile_mode, gpu_profile_frames, gpu_profile_names[stage],
+			gpu_profile_total[stage] / gpu_profile_frames);
+	memset(gpu_profile_total, 0, sizeof(gpu_profile_total));
+	gpu_profile_frames = 0;
+}
 
