diff --git a/tests/renderer-bloom.c b/tests/renderer-bloom.c
index 502b9271..0e4f38b5 100644
--- a/tests/renderer-bloom.c
+++ b/tests/renderer-bloom.c
@@ -1,9 +1,116 @@
 /* Record production restore quads without creating a GL context. */
 #include <assert.h>
+#include <stdarg.h>
 #include "../yquake2/src/refresh/r_bloom.c"
 
 viddef_t vid;
 refdef_t r_newrefdef;
+refimport_t ri;
+glconfig_t gl_config;
+static int queries, lookups, generated, deleted, missing_proc, zero_ids;
+static GLuint bound_framebuffer = 7, bound_renderbuffer = 8;
+static GLenum framebuffer_status = GL_FRAMEBUFFER_COMPLETE_EXT, pending_error;
+static void print_fn(int level, char *format, ...) { (void)level; (void)format; }
+static void APIENTRY get_integer(GLenum name, GLint *value)
+{
+	queries++;
+	if (name == GL_FRAMEBUFFER_BINDING_EXT) *value = bound_framebuffer;
+	else { assert(name == GL_RENDERBUFFER_BINDING_EXT); *value = bound_renderbuffer; }
+}
+static GLenum APIENTRY get_error(void)
+{ GLenum error = pending_error; pending_error = GL_NO_ERROR; return error; }
+static void APIENTRY gen_fb(GLsizei n, GLuint *id)
+{ assert(n == 1); *id = zero_ids ? 0 : 42; generated++; }
+static void APIENTRY gen_rb(GLsizei n, GLuint *id)
+{ assert(n == 1); *id = zero_ids ? 0 : 43; generated++; }
+static void APIENTRY delete_fb(GLsizei n, const GLuint *id)
+{ assert(n == 1 && *id == 42 && bound_framebuffer != *id); deleted++; }
+static void APIENTRY delete_rb(GLsizei n, const GLuint *id)
+{ assert(n == 1 && *id == 43 && bound_renderbuffer != *id); deleted++; }
+static void APIENTRY bind_fb(GLenum target, GLuint id)
+{ assert(target == GL_FRAMEBUFFER_EXT); bound_framebuffer = id; }
+static void APIENTRY bind_rb(GLenum target, GLuint id)
+{ assert(target == GL_RENDERBUFFER_EXT); bound_renderbuffer = id; }
+static void APIENTRY storage(GLenum target, GLenum format, GLsizei w, GLsizei h)
+{ assert(target == GL_RENDERBUFFER_EXT && format == GL_RGBA8 && w == BLOOM_SIZE && h == BLOOM_SIZE); }
+static void APIENTRY attach(GLenum target, GLenum point, GLenum type, GLuint id)
+{ assert(target == GL_FRAMEBUFFER_EXT && point == GL_COLOR_ATTACHMENT0_EXT && type == GL_RENDERBUFFER_EXT && id == 43); }
+static GLenum APIENTRY status(GLenum target)
+{ assert(target == GL_FRAMEBUFFER_EXT); return framebuffer_status; }
+static void APIENTRY buffer(GLenum which)
+{ assert(bound_framebuffer == 42 && which == GL_COLOR_ATTACHMENT0_EXT); }
+__typeof__(qglGetIntegerv) qglGetIntegerv = get_integer;
+__typeof__(qglGetError) qglGetError = get_error;
+__typeof__(qglDrawBuffer) qglDrawBuffer = buffer;
+__typeof__(qglReadBuffer) qglReadBuffer = buffer;
+void *GetProcAddressGL(char *name)
+{
+	lookups++;
+	if (lookups == missing_proc) return NULL;
+#define PROC(n, f) if (!strcmp(name, n)) return (void *)f
+	PROC("glGenFramebuffersEXT", gen_fb);
+	PROC("glDeleteFramebuffersEXT", delete_fb);
+	PROC("glBindFramebufferEXT", bind_fb);
+	PROC("glGenRenderbuffersEXT", gen_rb);
+	PROC("glDeleteRenderbuffersEXT", delete_rb);
+	PROC("glBindRenderbufferEXT", bind_rb);
+	PROC("glRenderbufferStorageEXT", storage);
+	PROC("glFramebufferRenderbufferEXT", attach);
+	PROC("glCheckFramebufferStatusEXT", status);
+#undef PROC
+	assert(0); return NULL;
+}
+
+static void test_workspace(void)
+{
+	cvar_t option = {0};
+	int missing, size;
+	gl_bloom_fbo = &option;
+	ri.Con_Printf = print_fn;
+	gl_config.extensions_string = "GL_EXT_framebuffer_object";
+	assert(!R_Bloom_BeginWorkspace() && !queries && !lookups);
+	option.value = 1;
+	gl_config.extensions_string = "";
+	assert(!R_Bloom_BeginWorkspace() && !queries && !lookups);
+	R_ShutdownBloom();
+	gl_config.extensions_string = "GL_EXT_framebuffer_object";
+	for (missing = 1; missing <= 9; missing++)
+	{
+		missing_proc = missing; lookups = 0;
+		assert(!R_Bloom_BeginWorkspace() && !generated && !queries);
+		R_ShutdownBloom();
+	}
+	missing_proc = 0;
+	for (size = 64; size <= 512; size *= 2)
+	{
+		BLOOM_SIZE = size;
+		generated = deleted = 0;
+		assert(R_Bloom_BeginWorkspace());
+		assert(bound_framebuffer == 42 && bound_renderbuffer == 8 && generated == 2);
+		R_Bloom_EndWorkspace();
+		assert(bound_framebuffer == 7);
+		assert(R_Bloom_BeginWorkspace() && generated == 2);
+		R_Bloom_EndWorkspace();
+		option.value = 0;
+		assert(!R_Bloom_BeginWorkspace() && bound_framebuffer == 7);
+		option.value = 1;
+		R_ShutdownBloom();
+		assert(deleted == 2 && !bloom_fbo.tried && !bloom_inited);
+	}
+	for (missing = 0; missing < 3; missing++)
+	{
+		generated = deleted = 0;
+		framebuffer_status = missing == 0 ? 0 : GL_FRAMEBUFFER_COMPLETE_EXT;
+		pending_error = missing == 1 ? GL_OUT_OF_MEMORY : GL_NO_ERROR;
+		zero_ids = missing == 2;
+		assert(!R_Bloom_BeginWorkspace());
+		assert(bound_framebuffer == 7 && bound_renderbuffer == 8);
+		assert(deleted == (zero_ids ? 0 : 2));
+		assert(!R_Bloom_BeginWorkspace() && generated == 2); /* don't retry each frame */
+		R_ShutdownBloom();
+	}
+	puts("bloom FBO: capability gates, bindings, reuse, allocation failure and cleanup pass");
+}
 static float vertices[4][4], texcoord[2];
 static int count;
 static void APIENTRY begin(GLenum mode) { assert(mode == GL_QUADS); count = 0; }
@@ -60,5 +167,6 @@ int main(void)
 		}
 	}
 	puts("bloom: full-view workspace mapping and reduced/offset fallback pass");
+	test_workspace();
 	return 0;
 }
