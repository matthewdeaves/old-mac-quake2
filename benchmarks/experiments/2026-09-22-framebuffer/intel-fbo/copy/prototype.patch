diff --git a/yquake2/src/refresh/r_bloom.c b/yquake2/src/refresh/r_bloom.c
index 6aceda59..cacfaa97 100644
--- a/yquake2/src/refresh/r_bloom.c
+++ b/yquake2/src/refresh/r_bloom.c
@@ -42,6 +42,16 @@ cvar_t *gl_bloom_alpha;      /* composite intensity */
 cvar_t *gl_bloom_darken;     /* bright-pass strength (multiply passes) */
 cvar_t *gl_bloom_size;       /* effect-texture size (pow2, 64..512) */
 cvar_t *gl_bloom_fastrestore; /* restore only the workspace for a full-screen view */
+cvar_t *gl_bloom_fbo;         /* optional single-sample off-screen workspace */
+
+#ifndef GL_FRAMEBUFFER_EXT
+#define GL_FRAMEBUFFER_EXT 0x8D40
+#define GL_RENDERBUFFER_EXT 0x8D41
+#define GL_FRAMEBUFFER_BINDING_EXT 0x8CA6
+#define GL_RENDERBUFFER_BINDING_EXT 0x8CA7
+#define GL_COLOR_ATTACHMENT0_EXT 0x8CE0
+#define GL_FRAMEBUFFER_COMPLETE_EXT 0x8CD5
+#endif
 
 /* TEXNUM_BLOOMSCREEN (pow2 >= view, raw back-buffer copy) and
  * TEXNUM_BLOOMEFFECT (BLOOM_SIZE^2, downsampled + blurred) are fixed manual
@@ -63,6 +73,112 @@ static float scr_tcw, scr_tch;
 static qboolean bloom_inited = false;
 static qboolean bloom_diagnostics_pending = true;
 
+static struct
+{
+	GLuint framebuffer, renderbuffer;
+	GLint previous;
+	qboolean tried;
+	void (APIENTRY *gen_framebuffers)(GLsizei, GLuint *);
+	void (APIENTRY *delete_framebuffers)(GLsizei, const GLuint *);
+	void (APIENTRY *bind_framebuffer)(GLenum, GLuint);
+	void (APIENTRY *gen_renderbuffers)(GLsizei, GLuint *);
+	void (APIENTRY *delete_renderbuffers)(GLsizei, const GLuint *);
+	void (APIENTRY *bind_renderbuffer)(GLenum, GLuint);
+	void (APIENTRY *storage)(GLenum, GLenum, GLsizei, GLsizei);
+	void (APIENTRY *attach)(GLenum, GLenum, GLenum, GLuint);
+	GLenum (APIENTRY *status)(GLenum);
+} bloom_fbo;
+
+void
+R_ShutdownBloom(void)
+{
+	if (bloom_fbo.framebuffer && bloom_fbo.delete_framebuffers)
+		bloom_fbo.delete_framebuffers(1, &bloom_fbo.framebuffer);
+	if (bloom_fbo.renderbuffer && bloom_fbo.delete_renderbuffers)
+		bloom_fbo.delete_renderbuffers(1, &bloom_fbo.renderbuffer);
+	memset(&bloom_fbo, 0, sizeof(bloom_fbo));
+	bloom_inited = false;
+}
+
+/* Keep the original copy-based blur, but run its small passes on a single-
+ * sample renderbuffer. The scene stays untouched and those copies no longer
+ * read the multisampled window. No framebuffer API is used when disabled. */
+static qboolean
+R_Bloom_BeginWorkspace(void)
+{
+	GLint previous, renderbuffer;
+	GLenum status, error;
+	if (!gl_bloom_fbo->value) return false;
+	if (!bloom_fbo.tried)
+	{
+		bloom_fbo.tried = true;
+		if (!gl_config.extensions_string ||
+			!strstr(gl_config.extensions_string, "GL_EXT_framebuffer_object"))
+		{
+			ri.Con_Printf(PRINT_ALL, "Bloom FBO unavailable: using window workspace.\n");
+			return false;
+		}
+#define BLOOM_PROC(member, name) bloom_fbo.member = (void *)GetProcAddressGL(name)
+		BLOOM_PROC(gen_framebuffers, "glGenFramebuffersEXT");
+		BLOOM_PROC(delete_framebuffers, "glDeleteFramebuffersEXT");
+		BLOOM_PROC(bind_framebuffer, "glBindFramebufferEXT");
+		BLOOM_PROC(gen_renderbuffers, "glGenRenderbuffersEXT");
+		BLOOM_PROC(delete_renderbuffers, "glDeleteRenderbuffersEXT");
+		BLOOM_PROC(bind_renderbuffer, "glBindRenderbufferEXT");
+		BLOOM_PROC(storage, "glRenderbufferStorageEXT");
+		BLOOM_PROC(attach, "glFramebufferRenderbufferEXT");
+		BLOOM_PROC(status, "glCheckFramebufferStatusEXT");
+#undef BLOOM_PROC
+		if (!bloom_fbo.gen_framebuffers || !bloom_fbo.delete_framebuffers ||
+			!bloom_fbo.bind_framebuffer || !bloom_fbo.gen_renderbuffers ||
+			!bloom_fbo.delete_renderbuffers || !bloom_fbo.bind_renderbuffer ||
+			!bloom_fbo.storage || !bloom_fbo.attach || !bloom_fbo.status)
+		{
+			ri.Con_Printf(PRINT_ALL, "Bloom FBO entry points missing: using window workspace.\n");
+			return false;
+		}
+		qglGetIntegerv(GL_FRAMEBUFFER_BINDING_EXT, &previous);
+		qglGetIntegerv(GL_RENDERBUFFER_BINDING_EXT, &renderbuffer);
+		bloom_fbo.gen_framebuffers(1, &bloom_fbo.framebuffer);
+		bloom_fbo.gen_renderbuffers(1, &bloom_fbo.renderbuffer);
+		if (bloom_fbo.framebuffer && bloom_fbo.renderbuffer)
+		{
+			bloom_fbo.bind_framebuffer(GL_FRAMEBUFFER_EXT, bloom_fbo.framebuffer);
+			bloom_fbo.bind_renderbuffer(GL_RENDERBUFFER_EXT, bloom_fbo.renderbuffer);
+			bloom_fbo.storage(GL_RENDERBUFFER_EXT, GL_RGBA8, BLOOM_SIZE, BLOOM_SIZE);
+			bloom_fbo.attach(GL_FRAMEBUFFER_EXT, GL_COLOR_ATTACHMENT0_EXT,
+				GL_RENDERBUFFER_EXT, bloom_fbo.renderbuffer);
+			qglDrawBuffer(GL_COLOR_ATTACHMENT0_EXT);
+			qglReadBuffer(GL_COLOR_ATTACHMENT0_EXT);
+			status = bloom_fbo.status(GL_FRAMEBUFFER_EXT);
+		}
+		else status = 0;
+		error = qglGetError();
+		bloom_fbo.bind_renderbuffer(GL_RENDERBUFFER_EXT, renderbuffer);
+		bloom_fbo.bind_framebuffer(GL_FRAMEBUFFER_EXT, previous);
+		if (status != GL_FRAMEBUFFER_COMPLETE_EXT || error != GL_NO_ERROR)
+		{
+			R_ShutdownBloom();
+			bloom_fbo.tried = true;
+			/* Texture initialization succeeded; only the optional workspace failed. */
+			bloom_inited = true;
+			ri.Con_Printf(PRINT_ALL, "Bloom FBO failed (status 0x%x, error 0x%x): using window workspace.\n", status, error);
+			return false;
+		}
+		ri.Con_Printf(PRINT_ALL, "Bloom FBO workspace: %dx%d RGBA8, single-sample.\n", BLOOM_SIZE, BLOOM_SIZE);
+	}
+	if (!bloom_fbo.framebuffer) return false;
+	qglGetIntegerv(GL_FRAMEBUFFER_BINDING_EXT, &bloom_fbo.previous);
+	bloom_fbo.bind_framebuffer(GL_FRAMEBUFFER_EXT, bloom_fbo.framebuffer);
+	return true;
+}
+
+static void
+R_Bloom_EndWorkspace(void)
+{
+	bloom_fbo.bind_framebuffer(GL_FRAMEBUFFER_EXT, bloom_fbo.previous);
+}
+
 static int
 R_Bloom_RoundUpPow2(int v)
 {
@@ -77,7 +193,7 @@ R_Bloom_RoundUpPow2(int v)
